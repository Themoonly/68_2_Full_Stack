<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User</title>
</head>
<body>
    <a href="/books">Books</a>
    <a href="/users">Users</a>
    <a href="/borrow">Borrow</a>

    <br>
    <a href="/users/add">Add User</a>
    <table>
        <tr>
            <th>Title</th>
            <th>name</th>
            <th>Actions</th>
        </tr>
        <% Users.forEach(user => { %>
            <tr>
                <td><%= user.title %></td>
                <td><%= user.name %></td>
                <td>
                    <a href="/users/<%= user.id %>/edit">Edit</a>
                    <a href="/users/<%= user.id %>/delete" onclick="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบผู้ใช้นี้?')">Delete</a>
                </td>
            </tr>
        <% }) %>
        
    </table>
</body>
</html>